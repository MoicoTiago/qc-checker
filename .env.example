# Database
MONGODB_URI=mongodb://127.0.0.1:27017/qc-checker

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication (replace with a long, random value)
JWT_SECRET=replace-with-a-long-random-secret

# Optional SMTP configuration
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@example.com

# Optional analysis and retention configuration
PRELOAD_ML=true
REPORT_FILE_RETENTION_DAYS=30
DISABLE_REPORT_FILE_CLEANUP=false
DEBUG_ML_SECTIONS=false
